# =========================================================
# TG-bPASS Platform - Environment Configuration Template
# Copy this file to .env and fill in your confidential values
# =========================================================

# Administrator Email (Authorized to receive OTPs)
TGBPASS_ADMIN_EMAIL=your_email@gmail.com

# SMTP Email Dispatch Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False

# MySQL Database Configuration
TGBPASS_DB_HOST=localhost
TGBPASS_DB_PORT=3306
TGBPASS_DB_USER=root
TGBPASS_DB_PASSWORD=your_mysql_password
TGBPASS_DB_NAME=tgbpass

# Admin Security Keys
TGBPASS_ADMIN_PIN=Adgjmptw@Tgbpass
SECRET_KEY=tgbpass_secret_dashboard_key_2026

# =========================================================
# Data & Document File Paths Configuration
# Supports single paths or comma-separated lists of paths
# =========================================================

# Master Proposals CSV File(s) (searched in order / merged)
CSV_PATHS=D:\Selenium\TGBP SITE\all_proposals.csv, D:\Selenium\TGBPSS\all_proposals.csv
CSV_PATH=D:\Selenium\TGBPSS\all_proposals.csv

# DPMS OC & BP Dataset CSV File(s)
OC_BP_CSV_PATHS=D:\Selenium\TGBPSS\all_proposals_oc.csv
OC_BP_CSV_PATH=D:\Selenium\TGBPSS\all_proposals_oc.csv

# DPMS OC & BP Root Directory / Directories
OC_BP_DIRS=D:\Selenium\TGBPSS\oc's & bp's
OC_BP_DIR=D:\Selenium\TGBPSS\oc's & bp's

# Document / PDF Storage Directories (comma-separated list for Inspection reports, drawings, proceedings)
DOCUMENT_DIRS=D:\Selenium\TGBPSS\Downloaded_Proposals, D:\Selenium\TGBPSS\Downloaded_Proposals1, D:\Selenium\TGBPSS\oc's & bp's, D:\Selenium\TGBP SITE\Downloaded_Proposals

# Scraper Progress and Log Files
PROGRESS_PATH=D:\Selenium\TGBPSS\progress.json
LOG_PATH=D:\Selenium\TGBPSS\scraper.log

